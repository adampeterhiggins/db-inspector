{
  "name": "db-inspector",
  "displayName": "DB Inspector",
  "description": "DataGrip-like database explorer and query runner for VS Code",
  "version": "0.0.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adampeterhiggins/db-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/adampeterhiggins/db-inspector/issues"
  },
  "homepage": "https://github.com/adampeterhiggins/db-inspector#readme",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:dbInspector.connectionsView",
    "onCommand:dbInspector.addConnection",
    "onCommand:dbInspector.runQuery",
    "onCommand:dbInspector.openQueryEditor",
    "onCommand:dbInspector.runQueryRange",
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbInspector",
          "title": "DB Inspector",
          "icon": "media/db-inspector-activity.svg"
        }
      ]
    },
    "views": {
      "dbInspector": [
        {
          "id": "dbInspector.connectionsView",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "dbInspector.addConnection",
        "title": "Add Connection",
        "icon": {
          "light": "media/commands/add-light.svg",
          "dark": "media/commands/add-dark.svg"
        }
      },
      {
        "command": "dbInspector.editConnection",
        "title": "Edit Connection",
        "icon": {
          "light": "media/commands/edit-light.svg",
          "dark": "media/commands/edit-dark.svg"
        }
      },
      {
        "command": "dbInspector.deleteConnection",
        "title": "Delete Connection",
        "icon": {
          "light": "media/commands/delete-light.svg",
          "dark": "media/commands/delete-dark.svg"
        }
      },
      {
        "command": "dbInspector.connect",
        "title": "Connect",
        "icon": {
          "light": "media/commands/connect-light.svg",
          "dark": "media/commands/connect-dark.svg"
        }
      },
      {
        "command": "dbInspector.disconnect",
        "title": "Disconnect",
        "icon": {
          "light": "media/commands/disconnect-light.svg",
          "dark": "media/commands/disconnect-dark.svg"
        }
      },
      {
        "command": "dbInspector.refresh",
        "title": "Refresh",
        "icon": {
          "light": "media/commands/refresh-light.svg",
          "dark": "media/commands/refresh-dark.svg"
        }
      },
      {
        "command": "dbInspector.openQueryEditor",
        "title": "Open SQL Editor",
        "icon": {
          "light": "media/commands/sql-light.svg",
          "dark": "media/commands/sql-dark.svg"
        }
      },
      {
        "command": "dbInspector.runQuery",
        "title": "Run Query"
      },
      {
        "command": "dbInspector.runQueryRange",
        "title": "Run Query (Inline)"
      },
      {
        "command": "dbInspector.useConnection",
        "title": "Use Connection",
        "icon": {
          "light": "media/commands/use-light.svg",
          "dark": "media/commands/use-dark.svg"
        }
      },
      {
        "command": "dbInspector.showObjectDDL",
        "title": "{} Show Object DDL",
        "icon": {
          "light": "media/commands/ddl-light.svg",
          "dark": "media/commands/ddl-dark.svg"
        }
      },
      {
        "command": "dbInspector.previewTableData",
        "title": "[] Preview Table Data",
        "icon": {
          "light": "media/commands/preview-light.svg",
          "dark": "media/commands/preview-dark.svg"
        }
      },
      {
        "command": "dbInspector.newQueryConsoleFromTable",
        "title": "> New Query Console",
        "icon": {
          "light": "media/commands/console-light.svg",
          "dark": "media/commands/console-dark.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbInspector.addConnection",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.openQueryEditor",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@2"
        },
        {
          "command": "dbInspector.refresh",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dbInspector.connect",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.connectionDisconnected",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.disconnect",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.connectionConnected",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.useConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "navigation@2"
        },
        {
          "command": "dbInspector.editConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "navigation"
        },
        {
          "command": "dbInspector.deleteConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "navigation"
        },
        {
          "command": "dbInspector.previewTableData",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.table",
          "group": "navigation@2"
        },
        {
          "command": "dbInspector.newQueryConsoleFromTable",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.table",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.showObjectDDL",
          "when": "view == dbInspector.connectionsView && (viewItem == dbInspector.table || viewItem == dbInspector.view || viewItem == dbInspector.function)",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "dbInspector.runQuery",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dbInspector.runQuery",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "DB Inspector",
      "properties": {
        "dbInspector.previewRowLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum number of rows returned for table preview."
        },
        "dbInspector.connectOnExpand": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect when expanding a disconnected connection node."
        },
        "dbInspector.enableQueryCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline run buttons above SQL statements in SQL editors."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc -p . --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.18.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mysql2": "^3.14.0",
    "pg": "^8.14.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
}
