{
  "name": "db-inspector",
  "displayName": "DB Inspector",
  "description": "DataGrip-like database explorer and query runner for VS Code",
  "version": "0.0.2",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adampeterhiggins/db-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/adampeterhiggins/db-inspector/issues"
  },
  "homepage": "https://github.com/adampeterhiggins/db-inspector#readme",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:dbInspector.connectionsView",
    "onCommand:dbInspector.addConnection",
    "onCommand:dbInspector.runQuery",
    "onCommand:dbInspector.openQueryEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbInspector",
          "title": "DB Inspector",
          "icon": "media/db-inspector-activity.svg"
        }
      ]
    },
    "views": {
      "dbInspector": [
        {
          "id": "dbInspector.connectionsView",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "dbInspector.addConnection",
        "title": "DB Inspector: Add Connection",
        "icon": {
          "light": "media/commands/add-light.svg",
          "dark": "media/commands/add-dark.svg"
        }
      },
      {
        "command": "dbInspector.editConnection",
        "title": "DB Inspector: Edit Connection"
      },
      {
        "command": "dbInspector.deleteConnection",
        "title": "DB Inspector: Delete Connection"
      },
      {
        "command": "dbInspector.connect",
        "title": "DB Inspector: Connect"
      },
      {
        "command": "dbInspector.disconnect",
        "title": "DB Inspector: Disconnect"
      },
      {
        "command": "dbInspector.refresh",
        "title": "DB Inspector: Refresh",
        "icon": {
          "light": "media/commands/refresh-light.svg",
          "dark": "media/commands/refresh-dark.svg"
        }
      },
      {
        "command": "dbInspector.openQueryEditor",
        "title": "DB Inspector: Open SQL Editor",
        "icon": {
          "light": "media/commands/sql-light.svg",
          "dark": "media/commands/sql-dark.svg"
        }
      },
      {
        "command": "dbInspector.runQuery",
        "title": "DB Inspector: Run Query"
      },
      {
        "command": "dbInspector.useConnection",
        "title": "DB Inspector: Use Connection"
      },
      {
        "command": "dbInspector.showObjectDDL",
        "title": "DB Inspector: Show Object DDL"
      },
      {
        "command": "dbInspector.previewTableData",
        "title": "DB Inspector: Preview Table Data"
      },
      {
        "command": "dbInspector.newQueryConsoleFromTable",
        "title": "New Query Console",
        "category": "DB Inspector"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbInspector.addConnection",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.openQueryEditor",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@2"
        },
        {
          "command": "dbInspector.refresh",
          "when": "view == dbInspector.connectionsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dbInspector.connect",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.connectionDisconnected",
          "group": "inline"
        },
        {
          "command": "dbInspector.disconnect",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.connectionConnected",
          "group": "inline"
        },
        {
          "command": "dbInspector.useConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "inline"
        },
        {
          "command": "dbInspector.editConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "navigation"
        },
        {
          "command": "dbInspector.deleteConnection",
          "when": "view == dbInspector.connectionsView && viewItem =~ /^dbInspector\\.connection/",
          "group": "navigation"
        },
        {
          "command": "dbInspector.previewTableData",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.table",
          "group": "inline"
        },
        {
          "command": "dbInspector.newQueryConsoleFromTable",
          "when": "view == dbInspector.connectionsView && viewItem == dbInspector.table",
          "group": "navigation@1"
        },
        {
          "command": "dbInspector.showObjectDDL",
          "when": "view == dbInspector.connectionsView && (viewItem == dbInspector.table || viewItem == dbInspector.view || viewItem == dbInspector.function)",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "dbInspector.runQuery",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dbInspector.runQuery",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "DB Inspector",
      "properties": {
        "dbInspector.previewRowLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum number of rows returned for table preview."
        },
        "dbInspector.connectOnExpand": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect when expanding a disconnected connection node."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc -p . --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.18.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mysql2": "^3.14.0",
    "pg": "^8.14.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
}
